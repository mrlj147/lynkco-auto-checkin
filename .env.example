# Lynk & Co 自动签到 - 环境变量配置
# 复制此文件为 .env 并填入你的值

# 登录态 Token（30 分钟过期，过期前自动续期）
LYNKCO_CENTER_TOKEN=bearer你的token

# 刷新 Token（可自动续期，仍可能被服务端撤销）
LYNKCO_REFRESH_TOKEN=bearer你的refreshToken

# Bark 推送 Key（可选，不填则不推送）
LYNKCO_BARK_KEY=你的BarkKey

# 企业微信机器人 Webhook（可选）
# LYNKCO_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key

# 钉钉机器人 Webhook（可选）
# LYNKCO_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=你的token

# 飞书机器人 Webhook（可选）
# LYNKCO_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/你的hook

# Token 缓存路径（持久化到 volume，防止容器重建后丢失）
LYNKCO_TOKEN_CACHE_PATH=/data/token_cache.json

# 签到窗口（默认凌晨 1 点到 6 点随机签到）
# 改成下午 1 点到 6 点：LYNKCO_CHECKIN_START=13 / LYNKCO_CHECKIN_END=18
LYNKCO_CHECKIN_START=1
LYNKCO_CHECKIN_END=6

# 同次登录请求中的 deviceId：续期必填
LYNKCO_DEVICE_ID=你的deviceId

# 原生 App 密钥：新签到、积分和分享必填；请勿替换旧评论的 CA_KEY/CA_SECRET
LYNKCO_NATIVE_APP_KEY=你的AppKey
LYNKCO_NATIVE_APP_SECRET=你的AppSecret
# 可选：优先使用 APPCODE 续期，失败后自动回退原生 HMAC
# LYNKCO_NATIVE_APP_CODE=你的AppCode
# 可选：未配置时使用 deviceId
# LYNKCO_NATIVE_GL_DEV_ID=你的gl_dev_id
# 或使用整合 JSON（独立字段优先）：
# LYNKCO_APP_SECRETS={"nativeAppKey":"...","nativeAppSecret":"...","nativeAppCode":"...","glDevId":"..."}
# 可选：从抓包保存的设备请求头 JSON
# LYNKCO_DEVICE_HEADERS={"gl_dev_platform":"iOS","gl_app_version":"4.2.8","gl_app_build":"..."}

# 积分异步到账的等待秒数
LYNKCO_ENERGY_DELAY=5

# 自动评论保持原功能，开启后在每日任务结束 5 分钟后执行
LYNKCO_COMMENT_ENABLED=false
LYNKCO_COMMENT_LIMIT=3
# DEEPSEEK_API_KEY=你的APIKey
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
